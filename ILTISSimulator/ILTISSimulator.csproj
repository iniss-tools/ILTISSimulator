<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>ILTISSimulator</RootNamespace>
		<AssemblyName>ILTISSimulator</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>ILTISSimulator.Program</StartupObject>
		<ApplicationIcon>gtn.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Zodpovedá pôvodnému App.config System.Windows.Forms.ApplicationConfigurationSection
		     (DpiAwareness=PerMonitorV2 + EnableWindowsFormsHighDpiAutoResizing=true). Pozri [[winforms-permonitorv2-scaling]] -
		     rozloženie sa neškáluje samo, aplikácia už má na to vlastnú logiku v Tools\DpiTools.cs. -->
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\GVDEditor\GVDEditor\GVDEditor.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
</Project>
