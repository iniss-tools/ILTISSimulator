<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>GTNCommands</RootNamespace>
		<AssemblyName>GTNCommands</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>GTNCommands.Program</StartupObject>
		<ApplicationIcon>gtn.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
</Project>
