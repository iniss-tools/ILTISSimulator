<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>ILTISSimulator</RootNamespace>
		<AssemblyName>ILTISSimulator</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- verzia lokalnych zostav; vydanie ju prepise verziou zo znacky vX.Y (ToolsCore\Build\AppRelease.props) -->
		<Version>1.1</Version>
		<Description>Simulátor rozhrania ILTIS-INISS (GTN)</Description>
		<NeutralLanguage>sk</NeutralLanguage>
		<StartupObject>ILTISSimulator.Program</StartupObject>
		<ApplicationIcon>gtn.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
		<!-- Ako GVDEditor, ktory referencuje (inak MSB3270). Bez RID kopiruje SDK do runtimes\ aj nativne kniznice
		     pre Android, Linux a macOS (tahaju ich balicky ako System.IO.Ports). SelfContained=false: program je
		     zavisly od frameworku. AppendRuntimeIdentifierToOutputPath=false: vystup ostava v bin\<konfiguracia>\net10.0-windows,
		     odkial ho berie ILTISSimulatorInstaller.iss. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- Slovencina je v hlavnej zostave, prelozena je len cestina. Ostatne jazyky su satelity balickov
		     (System.ServiceModel a spol.), ktore program nikdy nezobrazi. -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\GVDEditor\GVDEditor\GVDEditor.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
	<!-- spolocne vlastnosti vydavanych programov: vyrobca, verzia a index aktualizacii z vydania -->
	<Import Project="..\..\ToolsCore\Build\AppRelease.props" />
</Project>
